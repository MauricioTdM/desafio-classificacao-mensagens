# IA (Google Gemini) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Abaixo desse valor de confiança a mensagem é marcada para revisão humana
LIMIAR_CONFIANCA=0.6

# n8n (Settings > n8n API > Create API key) - usado só pelo scripts/configurar_n8n.py
N8N_URL=http://localhost:5678
N8N_API_KEY=
# URL da API vista de dentro do n8n: http://127.0.0.1:8000 (local) ou http://api:8000 (docker compose)
API_URL_N8N=http://127.0.0.1:8000

# Webhooks do Discord, um canal por setor (Canal > Editar > Integrações > Webhooks > Copiar URL)
DISCORD_WEBHOOK_ATENDIMENTO=
DISCORD_WEBHOOK_SAC=
DISCORD_WEBHOOK_OPERACOES=
DISCORD_WEBHOOK_TRIAGEM=
